<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow local subnet HTTP for printer embedded web servers (EWS), IPP, and Raw 9100 without compromising external HTTPS -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
