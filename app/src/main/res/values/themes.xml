<resources>
    <style name="Theme.SmartPrintDirect" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#0073A8</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>

    <!-- Cold-start splash (AndroidX SplashScreen: native on Android 12+, compat below) -->
    <style name="Theme.SmartPrintDirect.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A6AA6</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_anim</item>
        <item name="windowSplashScreenAnimationDuration">550</item>
        <item name="postSplashScreenTheme">@style/Theme.SmartPrintDirect</item>
    </style>
</resources>
